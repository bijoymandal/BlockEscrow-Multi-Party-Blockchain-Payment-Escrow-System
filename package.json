{
  "name": "blockescrow-workspace",
  "version": "1.0.0",
  "description": "BlockEscrow - Multi-Party Blockchain Payment & Escrow System",
  "main": "scripts/menu.js",
  "scripts": {
    "start": "node scripts/menu.js",
    "docs": "node scripts/menu.js",
    "menu": "node scripts/menu.js",
    "docs:web": "node scripts/serve-docs.js",
    "compile": "npm run compile --prefix contracts",
    "test": "npm run test:contracts && npm run test:ipfs && npm run test:backend",
    "test:contracts": "npm test --prefix contracts",
    "test:ipfs": "npm test --prefix packages/ipfs-service",
    "test:backend": "npm test --prefix backend",
    "start:backend": "npm start --prefix backend",
    "deploy:local": "npm run deploy:local --prefix contracts"
  },
  "keywords": [
    "blockchain",
    "escrow",
    "smart-contracts",
    "ethereum",
    "polygon",
    "arbitrum",
    "defi"
  ],
