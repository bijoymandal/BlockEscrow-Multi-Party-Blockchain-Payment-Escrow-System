{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlockEscrowMilestoneDeliverable",
  "type": "object",
  "required": [
    "version",
    "escrowId",
    "milestoneIndex",
    "seller",
    "summary",
    "submittedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "escrowId": {
      "type": "integer",
      "minimum": 1
    },
    "milestoneIndex": {
      "type": "integer",
      "minimum": 0
    },
    "seller": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 5000
    },
    "repoUrl": {
      "type": "string",
      "format": "uri"
    },
    "commitHash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{40}$"
    },
    "demoUrl": {
      "type": "string",
      "format": "uri"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "cid"],
        "additionalProperties": false,
        "properties": {
          "filename": { "type": "string" },
          "cid": { "type": "string" },
          "sizeBytes": { "type": "integer" },
          "mimeType": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
