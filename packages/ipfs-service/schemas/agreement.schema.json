{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BlockEscrowAgreement",
  "type": "object",
  "required": [
    "version",
    "title",
    "buyer",
    "seller",
    "arbitrator",
    "totalAmount",
    "tokenSymbol",
    "milestones"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 150
    },
    "description": {
      "type": "string",
      "maxLength": 5000
    },
    "buyer": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "seller": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "arbitrator": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "tokenSymbol": {
      "type": "string",
      "minLength": 2,
      "maxLength": 10
    },
    "tokenAddress": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "totalAmount": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?$"
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "title", "amount", "dueDate"],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "deliverables": {
            "type": "string"
          }
        }
      }
    },
    "disputeTerms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arbitrationFeeBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "evidenceWindowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "cid"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "cid": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
