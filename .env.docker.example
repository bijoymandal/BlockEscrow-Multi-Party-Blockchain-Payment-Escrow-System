# BlockEscrow Docker Environment Configuration
NODE_ENV=production

# Database
POSTGRES_USER=blockescrow
POSTGRES_PASSWORD=blockescrow_production_secure_pwd_123!
POSTGRES_DB=blockescrow_db

# Redis
REDIS_PASSWORD=redis_production_auth_pwd_998!

# Authentication & Security
JWT_SECRET=super_secret_production_jwt_key_min_32_characters_long_entropy

# Blockchain RPC Providers (Alchemy / Infura / Ankr)
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Telemetry & Monitoring
PROMETHEUS_PORT=9090
SLACK_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX
SENTRY_DSN=https://sample_key@sentry.io/123456
